{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MechKeyMesh",
  "version": "0.20.0-alpha.5",
  "identifier": "com.mechkeymesh.desktop",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MechKeyMesh",
        "width": 1320,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
